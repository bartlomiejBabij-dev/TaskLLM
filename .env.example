# Web application (never commit .env.local)
APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: used for account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Supabase direct/session pooler connection. Use TLS and validate its certificate.
DATABASE_URL=
# A dedicated Redis with persistence, noeviction and TLS in production.
REDIS_URL=redis://localhost:6379
# Base64 encoding of 32 cryptographically random bytes. Store in a secrets manager.
# All web/worker instances must use the same key. Back it up securely.
ENCRYPTION_KEY=
# Managed AI credentials; BYOK works independently of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Outgoing email requires a verified sending domain in Resend.
RESEND_API_KEY=
RESEND_FROM=
# Create recurring monthly USD Stripe prices and configure the customer portal.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BYOK=
